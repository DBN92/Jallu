# ============================================================
#  LUNA AI — configuração (copie para .env e ajuste)
#  NUNCA versione o arquivo .env. Ele contém segredos.
# ============================================================

# --- Servidor ---
NODE_ENV=production
# Endereço de escuta. Use 127.0.0.1 se só o Cloudflare Tunnel (no mesmo host)
# acessar a Luna; use 0.0.0.0 para permitir acesso pela rede local.
LUNA_HOST=0.0.0.0
LUNA_PORT=8787
# Domínio público (sem barra no final). Usado em CORS/CSRF e no manifest.
LUNA_PUBLIC_URL=https://luna.seudominio.com
# Confiar nos cabeçalhos X-Forwarded-* (necessário atrás do Cloudflare Tunnel)
LUNA_TRUST_PROXY=true
LOG_LEVEL=info

# --- Banco de dados (fora da pasta de build) ---
# Caminho absoluto recomendado, ex.: file:/DATA/AppData/luna-ai/data/luna.db
# Caminhos relativos são resolvidos a partir da raiz do projeto (luna-ai/).
DATABASE_URL=file:./data/luna.db

# --- Segurança ---
# Código exigido para criar o PRIMEIRO usuário (administrador).
# O install.sh gera um valor aleatório automaticamente.
LUNA_SETUP_CODE=troque-este-codigo
# Duração da sessão em horas
LUNA_SESSION_TTL_HOURS=720
# Cookie "Secure": auto (detecta HTTPS), true ou false
LUNA_COOKIE_SECURE=auto

# --- Home Assistant ---
# URL interna (rede local / host). NÃO exponha o HA publicamente por causa da Luna.
HA_URL=http://127.0.0.1:8123
# Token de longa duração: HA > Perfil > Segurança > Tokens de acesso de longa duração
HA_TOKEN=
# Domínios cujos dispositivos NOVOS já ficam autorizados para a IA (vírgula).
# Os demais precisam ser autorizados manualmente em "Minha casa".
LUNA_AI_AUTO_AUTHORIZE_DOMAINS=light

# --- IA local (Ollama) ---
OLLAMA_URL=http://127.0.0.1:11434
# Modelo com suporte a tools/function calling. Ex.: qwen2.5:3b, llama3.2:3b, qwen3:4b
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_MS=90000

# --- IA em nuvem (OpenAI) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Voz em tempo real (WebRTC)
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TIMEOUT_MS=60000

# --- Modo de IA padrão: local | cloud | hybrid ---
LUNA_AI_MODE=hybrid

# --- Clima ---
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
WEATHER_CACHE_MINUTES=10
TZ=America/Sao_Paulo
